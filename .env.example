# Optional archive RPC for the mainnet fork (never a signing key)
MAINNET_RPC_URL=https://your-archive-rpc.example
# Public unsigned deployment preflight
BASE_SEPOLIA_RPC_URL=https://your-base-sepolia-rpc.example
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000
LOAN_TOKEN=0x0000000000000000000000000000000000000000
COLLATERAL_TOKEN=0x0000000000000000000000000000000000000000
COLLATERAL_USD_FEED=0x0000000000000000000000000000000000000000
LOAN_USD_FEED=0x0000000000000000000000000000000000000000
SEQUENCER_FEED=0x0000000000000000000000000000000000000000
ORACLE_MAX_AGE=3600
# Optional override when the recorded fork pin is unavailable
MAINNET_FORK_BLOCK=26344752
# Optional explorer credential consumed by forge verify-contract
ETHERSCAN_API_KEY=replace_with_your_explorer_api_key
